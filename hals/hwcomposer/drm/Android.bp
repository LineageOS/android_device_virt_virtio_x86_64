package {
    default_applicable_licenses: ["virtio_x86_64_external_drm_hwcomposer_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "virtio_x86_64_external_drm_hwcomposer_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library_headers {
    name: "virtio_x86_64_drm_hwcomposer_headers",
    vendor: true,
    export_include_dirs: ["."],
}

// =====================
// hwcomposer.drm.so
// =====================
cc_defaults {
    name: "virtio_x86_64_hwcomposer.drm_defaults",

    shared_libs: [
        "android.hardware.graphics.composer@2.1-resources",
        "android.hardware.graphics.composer@2.2-resources",
        "libcutils",
        "libdrm",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libsync",
        "libui",
        "libutils",
    ],

    static_libs: [
        "libaidlcommonsupport",
    ],

    header_libs: [
        "virtio_x86_64_drm_hwcomposer_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    cppflags: [
        "-DHWC2_INCLUDE_STRINGIFICATION",
        "-DHWC2_USE_CPP11",
    ],

    cpp_std: "gnu++17",

    relative_install_path: "hw",
    vendor: true,
}

filegroup {
    name: "virtio_x86_64_drm_hwcomposer_common",
    srcs: [
        "bufferinfo/BufferInfoGetter.cpp",
        "bufferinfo/BufferInfoMapperMetadata.cpp",

        "compositor/DrmKmsPlan.cpp",
        "compositor/FlatteningController.cpp",

        "drm/DrmAtomicStateManager.cpp",
        "drm/DrmConnector.cpp",
        "drm/DrmCrtc.cpp",
        "drm/DrmDevice.cpp",
        "drm/DrmDisplayPipeline.cpp",
        "drm/DrmEncoder.cpp",
        "drm/DrmFbImporter.cpp",
        "drm/DrmHwc.cpp",
        "drm/DrmMode.cpp",
        "drm/DrmPlane.cpp",
        "drm/DrmProperty.cpp",
        "drm/ResourceManager.cpp",
        "drm/UEventListener.cpp",
        "drm/VSyncWorker.cpp",

        "backend/Backend.cpp",
        "backend/BackendClient.cpp",
        "backend/BackendManager.cpp",

        "hwc2_device/DrmHwcTwo.cpp",
        "hwc2_device/HwcDisplay.cpp",
        "hwc2_device/HwcDisplayConfigs.cpp",
        "hwc2_device/HwcLayer.cpp",
        "hwc2_device/hwc2_device.cpp",

        "utils/fd.cpp",
        "utils/properties.cpp",
    ],
}

filegroup {
    name: "virtio_x86_64_drm_hwcomposer_hwc3",
    srcs: [
        "hwc3/Composer.cpp",
        "hwc3/ComposerClient.cpp",
        "hwc3/ComposerResources.cpp",
        "hwc3/DrmHwcThree.cpp",
        "hwc3/Utils.cpp",
    ],
}

filegroup {
    name: "virtio_x86_64_drm_hwcomposer_service",
    srcs: [
        "hwc3/service.cpp",
    ],
}

cc_binary {
    name: "android.hardware.composer.hwc3-service.drm.virtio_x86_64",

    srcs: [
        ":virtio_x86_64_drm_hwcomposer_common",
        ":virtio_x86_64_drm_hwcomposer_hwc3",
        ":virtio_x86_64_drm_hwcomposer_service",
        "bufferinfo/legacy/BufferInfoLibdrm.cpp",
    ],

    defaults: [
        "virtio_x86_64_hwcomposer.drm_defaults",
    ],

    shared_libs: [
        "android.hardware.graphics.composer3-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-Wall",
        "-Werror",

        "-DUSE_IMAPPER4_METADATA_API",
    ],

    cppflags: [
        "-DHWC2_INCLUDE_STRINGIFICATION",
        "-DHWC2_USE_CPP11",
    ],

    relative_install_path: "hw",
    vendor: true,

    init_rc: ["hwc3/hwc3-drm-virtio_x86_64.rc"],
}
